{
  "info": {
    "name": "校庆纪念品认购平台 API 测试集合",
    "description": "覆盖小程序端和管理后台全量API接口，含自动化测试断言，可通过 Newman 在 CI 流水线执行",
    "_postman_id": "xq-2026-api-collection-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "skuId", "value": "1", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "addressId", "value": "1", "type": "string" },
    { "key": "wxCode", "value": "test_wx_code", "type": "string" },
    { "key": "adminPassword", "value": "Admin123456", "type": "string" }
  ],
  "item": [
    {
      "name": "1. 认证模块 (REQ-001~010)",
      "item": [
        {
          "name": "微信登录 [TC-001]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/wx-login",
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{wxCode}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('响应格式正确', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.equal(0);",
              "  pm.expect(body.data.accessToken).to.be.a('string');",
              "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
              "});"
            ]}
          }]
        },
        {
          "name": "提交校友认证申请 [TC-005]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/alumni/apply",
            "body": { "mode": "raw", "raw": "{\n  \"realName\": \"张三\",\n  \"studentId\": \"2020001\",\n  \"graduationYear\": 2024,\n  \"major\": \"计算机科学\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('申请成功', () => {",
              "  const body = pm.response.json();",
              "  pm.expect([0, 10005]).to.include(body.code);",
              "});"
            ]}
          }]
        },
        {
          "name": "查询校友认证状态 [TC-006]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/alumni/status"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回认证状态', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.status).to.be.a('string');",
              "});"
            ]}
          }]
        },
        {
          "name": "刷新Token [TC-007]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{accessToken}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('刷新成功或Token无效', () => {",
              "  pm.expect([200, 401]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "2. 商品模块 (REQ-016~025)",
      "item": [
        {
          "name": "获取商品分类 [TC-016]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/categories"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回分类数组', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "获取商品列表 [TC-020]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products",
            "query": [
              { "key": "page", "value": "1" },
              { "key": "pageSize", "value": "20" }
            ]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回分页数据', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.list).to.be.an('array');",
              "  pm.expect(body.data.total).to.be.a('number');",
              "  if (body.data.list.length > 0) {",
              "    pm.collectionVariables.set('productId', body.data.list[0].id);",
              "    if (body.data.list[0].skus && body.data.list[0].skus.length > 0) {",
              "      pm.collectionVariables.set('skuId', body.data.list[0].skus[0].id);",
              "    }",
              "  }",
              "});"
            ]}
          }]
        },
        {
          "name": "关键词搜索商品 [TC-021]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products",
            "query": [{ "key": "keyword", "value": "纪念" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回搜索结果', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.list).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "获取商品详情 [TC-022]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('商品详情完整', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.name).to.be.a('string');",
              "  pm.expect(body.data.skus).to.be.an('array');",
              "  pm.expect(parseFloat(body.data.price)).to.be.above(0);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "3. 购物车模块 (REQ-026~030)",
      "item": [
        {
          "name": "获取购物车 [TC-025]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/cart"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回购物车数据', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.items).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "加入购物车 [TC-026]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"skuId\": {{skuId}},\n  \"quantity\": 1\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('加购成功或库存不足', () => {",
              "  pm.expect([200, 201, 400, 404]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "4. 物流地址模块 (REQ-049~052)",
      "item": [
        {
          "name": "获取收货地址列表",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/logistics/addresses"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回地址列表', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "  if (body.data.length > 0) {",
              "    pm.collectionVariables.set('addressId', body.data[0].id);",
              "  }",
              "});"
            ]}
          }]
        },
        {
          "name": "新增收货地址",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/logistics/addresses",
            "body": { "mode": "raw", "raw": "{\n  \"receiverName\": \"张三\",\n  \"phone\": \"13800138000\",\n  \"province\": \"北京市\",\n  \"city\": \"北京市\",\n  \"district\": \"海淀区\",\n  \"detail\": \"中关村大街1号\",\n  \"isDefault\": true\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('新增地址成功', () => {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "  const body = pm.response.json();",
              "  if (body.data && body.data.id) {",
              "    pm.collectionVariables.set('addressId', body.data.id);",
              "  }",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "5. 订单模块 (REQ-031~040)",
      "item": [
        {
          "name": "创建订单 [TC-028]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/orders",
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}},\n  \"items\": [{\"skuId\": {{skuId}}, \"quantity\": 1}]\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test('订单号格式正确', () => {",
              "    pm.expect(body.data.orderNo).to.match(/^XQ\\d{14}$/);",
              "  });",
              "  pm.test('订单状态为待支付', () => {",
              "    pm.expect(body.data.status).to.equal('pending_payment');",
              "  });",
              "  pm.collectionVariables.set('orderId', body.data.id);",
              "} else {",
              "  pm.test('未认证或库存不足', () => {",
              "    pm.expect([400, 403]).to.include(pm.response.code);",
              "  });",
              "}"
            ]}
          }]
        },
        {
          "name": "获取订单列表 [TC-032]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/orders"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回分页数据', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.list).to.be.an('array');",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "6. 支付模块 (REQ-041~048)",
      "item": [
        {
          "name": "获取汇率 [TC-048]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/exchange-rate",
            "query": [
              { "key": "from", "value": "USD" },
              { "key": "to", "value": "CNY" }
            ]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('汇率数据有效', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(parseFloat(body.data.rate)).to.be.above(0);",
              "});"
            ]}
          }]
        },
        {
          "name": "微信支付预下单 [TC-030]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/payments/wx/prepay",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{orderId}}\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.test('返回微信支付参数', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.timeStamp).to.be.a('string');",
              "    pm.expect(body.data.package).to.contain('prepay_id=');",
              "  });",
              "}"
            ]}
          }]
        }
      ]
    },
    {
      "name": "7. 定制刻字模块 (REQ-059~065)",
      "item": [
        {
          "name": "获取字体列表 [TC-059]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/customization/fonts"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回字体列表', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.data.length).to.be.above(0);",
              "});"
            ]}
          }]
        },
        {
          "name": "校验刻字内容 [TC-071]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/customization/validate",
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"校庆纪念2026\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('校验通过', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.valid).to.be.true;",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "8. 通知模块 (REQ-073~078)",
      "item": [
        {
          "name": "获取通知列表 [TC-073]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/notifications"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回分页通知', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.list).to.be.an('array');",
              "});"
            ]}
          }]
        },
        {
          "name": "获取未读数量 [TC-076]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/notifications/unread-count"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200', () => pm.response.to.have.status(200));",
              "pm.test('返回未读数量', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.count).to.be.a('number');",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "9. 管理后台 (REQ-079~145)",
      "item": [
        {
          "name": "管理员登录 [TC-110]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('获取管理员token', () => {",
              "    pm.expect(body.data.accessToken).to.be.a('string');",
              "    pm.collectionVariables.set('adminToken', body.data.accessToken);",
              "  });",
              "}"
            ]}
          }]
        },
        {
          "name": "校友认证申请列表 [TC-086]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/alumni/verifications",
            "query": [{ "key": "status", "value": "pending" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200或401', () => {",
              "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        },
        {
          "name": "获取订单列表（管理端） [TC-103]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/orders",
            "query": [{ "key": "page", "value": "1" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('状态码为200或401', () => {",
              "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
              "});"
            ]}
          }]
        },
        {
          "name": "销售总览报表 [TC-100]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/reports/overview",
            "query": [
              { "key": "startDate", "value": "2026-03-01" },
              { "key": "endDate", "value": "2026-03-09" }
            ]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  pm.test('报表数据结构完整', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.have.property('totalOrders');",
              "    pm.expect(body.data).to.have.property('totalRevenue');",
              "  });",
              "}"
            ]}
          }]
        },
        {
          "name": "商品销量排行 [TC-102]",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/reports/product-ranking",
            "query": [{ "key": "limit", "value": "10" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
